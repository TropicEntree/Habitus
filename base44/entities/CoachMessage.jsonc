{
  "name": "CoachMessage",
  "type": "object",
  "properties": {
    "message": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "insight",
        "motivation",
        "warning",
        "celebration"
      ],
      "default": "motivation"
    },
    "context_summary": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "message"
  ]
}