{
  "name": "HabitLog",
  "type": "object",
  "properties": {
    "habit_id": {
      "type": "string"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "xp_earned": {
      "type": "number",
      "default": 10
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "habit_id",
    "completed_date"
  ]
}