{
  "name": "DailyMetric",
  "type": "object",
  "properties": {
    "log_date": {
      "type": "string",
      "format": "date"
    },
    "bathroom_visits": {
      "type": "number",
      "default": 0
    },
    "wake_time": {
      "type": "string"
    },
    "water_glasses": {
      "type": "number",
      "default": 0
    },
    "calories": {
      "type": "number",
      "default": 0
    },
    "activity_minutes": {
      "type": "number",
      "default": 0
    },
    "mood": {
      "type": "string",
      "enum": [
        "great",
        "good",
        "ok",
        "low",
        "bad"
      ],
      "default": "ok"
    },
    "todo_text": {
      "type": "string"
    },
    "improvement_text": {
      "type": "string"
    }
  },
  "required": [
    "log_date"
  ]
}