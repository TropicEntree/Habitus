{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "total_xp": {
      "type": "number",
      "default": 0
    },
    "level": {
      "type": "number",
      "default": 1
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "longest_streak": {
      "type": "number",
      "default": 0
    },
    "focus_minutes": {
      "type": "number",
      "default": 0
    },
    "exercise_minutes": {
      "type": "number",
      "default": 0
    },
    "photo_url": {
      "type": "string"
    },
    "bg_color": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "it",
        "en",
        "ko"
      ],
      "default": "it"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "premium"
      ],
      "default": "free"
    },
    "evening_mode": {
      "type": "boolean",
      "default": false
    }
  },
  "required": []
}