{
  "name": "TrainingProgram",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "physical",
        "mental",
        "study",
        "focus",
        "meditation"
      ]
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "default": "beginner"
    },
    "duration_minutes": {
      "type": "number"
    },
    "xp_reward": {
      "type": "number",
      "default": 25
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "icon": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "category"
  ]
}