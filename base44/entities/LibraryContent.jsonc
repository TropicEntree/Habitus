{
  "name": "LibraryContent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "neuroscienza",
        "produttivita",
        "mindset",
        "emozioni",
        "studio"
      ],
      "default": "mindset"
    },
    "language": {
      "type": "string",
      "enum": [
        "it",
        "en",
        "ko"
      ],
      "default": "it"
    },
    "duration_minutes": {
      "type": "number",
      "default": 3
    },
    "emoji": {
      "type": "string",
      "default": "\ud83c\udf3f"
    },
    "summary": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "is_premium": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "category"
  ]
}